PORT=3000

# Supabase Postgres connection string.
# Use this for the transaction pooler or direct connection URL from Supabase.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DB_SSL=true

# Local Postgres fallback. These values are used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=assistant_server
